{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebrazenbeard.github.io/project-runner/schemas/frontier.schema.json",
  "title": "Project Runner Frontier",
  "type": "object",
  "required": [
    "id",
    "project",
    "subject",
    "work_type",
    "reason",
    "dependencies",
    "required_capabilities",
    "collision_keys",
    "cost_class",
    "priority_inputs",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "required": [
        "repository",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "work_type": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "collision_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cost_class": {
      "enum": [
        "TRIVIAL",
        "SMALL",
        "MEDIUM",
        "LARGE"
      ]
    },
    "priority_inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "status": {
      "enum": [
        "READY",
        "WAITING_DEPENDENCY",
        "WAITING_AUTHORITY",
        "WAITING_SCHEDULING",
        "RUNNING",
        "VERIFYING",
        "COMPLETE",
        "FAILED_RETRYABLE",
        "FAILED_DETERMINISTIC",
        "OUTCOME_UNKNOWN",
        "SUPERSEDED"
      ]
    }
  }
}
